; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SoccerHeadz"
run/main_scene="uid://bswec7weouqpa"
config/features=PackedStringArray("4.6", "C#", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=2304
window/size/viewport_height=1536

[dotnet]

project/assembly_name="SoccerHeadz"

[editor_plugins]

enabled=PackedStringArray("res://addons/GitGodot/plugin.cfg", "res://addons/github_copilot/plugin.cfg")

[physics]

