[node name="TitleLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Instructions"
horizontal_alignment = 1

[node name="InstructionsText" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(900, 500)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Controls[/b]

Player 1:
Move left/right: A / D
Jump: W
Kick / interaction: Space

Player 2:
Move left/right: Left Arrow / Right Arrow
Jump: Up Arrow
Kick / interaction: Enter

[b]Objective[/b]

Hit the ball into the opponent's goal to score a point.

[b]Match Rules[/b]

The match ends when a player reaches the score limit or when the timer runs out.
After each goal, players and the ball reset to their starting positions."

[node name="BackButton" type="Button" parent="MarginContainer/VBoxContainer"]
